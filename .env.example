# Copy to .env (never committed) and fill in.
# Google Cloud project registered for Earth Engine (noncommercial is free):
EE_PROJECT=your-gcp-project-id

# Optional: service account for unattended runs (path to the JSON key, or the JSON itself)
# GEE_SERVICE_ACCOUNT_KEY=/path/to/gee-key.json

# Optional defaults for every step
# MM_START=2019-01-01
# MM_PRICES_CSV=data/my_prices.csv          # date,commodity,price  (adds nickel, lithium, iron ore...)
# MM_PRODUCTION_CSV=data/my_production.csv  # site,date,value       (reported output, for validation)
